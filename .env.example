# Copy to .env and fill in. .env is gitignored; never commit it.
# Server (the DigitalOcean Droplet)
DO_MODEL_ACCESS_KEY=       # DigitalOcean serverless inference: do/gemma-4-31B-it (cards, map) and do/bge-m3 (embeddings)
SERPAPI_API_KEY=           # YouTube transcripts and channel pages
MONGODB_URI=               # MongoDB Atlas: map data and vector search
WEBSUB_SECRET=             # shared secret for YouTube push notifications (any long random string)
CALLBACK_URL=              # public URL of src/server/webhook.ts, ending in /websub
PORT=8080                  # webhook port (default 8080)
SENTRY_DSN=                # optional: traces of every model call (timings and token counts only)
BACKBOARD_API_KEY=         # rules adopted by the nightly verifier
GEMINI_API_KEY=            # optional: only for gemini/... models in experiments
ELEBENT_API_KEY=           # ElevenLabs: spoken answers, morning briefing, calm music (the name is spelled this way in the code)

# Laptop: MONGODB_URI is enough for the morning pull; the local models run in Ollama (no key).
